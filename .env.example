# Salin menjadi .env.local lalu isi.

# Koneksi MySQL. Lokal (Laragon/XAMPP): mysql://root:@127.0.0.1:3306/cek_hatespeech
DATABASE_URL=mysql://root:@127.0.0.1:3306/cek_hatespeech
# Isi true untuk MySQL cloud yang mewajibkan TLS (TiDB Cloud, Aiven, dll.)
DB_SSL=false

# Kunci tanda tangan sesi login, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-64-karakter-acak

# Alamat API model (FastAPI di Colab lewat Cloudflare Tunnel), diakhiri /predict
API_URL=https://xxxx.trycloudflare.com/predict
